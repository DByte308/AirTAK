{
  "configurations": [
    {
      "name": "AirTAK (default)",
      "compilerPath": "${env:HOME}/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-g++",
      "compileCommands": "${workspaceFolder}/firmware/compile_commands_target.json",
      "includePath": [
        "${workspaceFolder}/firmware/include",
        "${workspaceFolder}/firmware/src",
        "${workspaceFolder}/firmware/src/proto",
        "${workspaceFolder}/firmware/src/native_stubs",
        "${workspaceFolder}/firmware/test",
        "${workspaceFolder}/firmware/.pio/libdeps/native/Unity/src",
        "${workspaceFolder}/firmware/.pio/libdeps/native/Nanopb"
      ],
      "defines": [
        "AIRTAK_BOARD_T_ECHO_PLUS"
      ],
      "intelliSenseMode": "gcc-arm"
    },
    {
      "name": "AirTAK (native tests)",
      "compilerPath": "/usr/bin/g++",
      "compileCommands": "${workspaceFolder}/firmware/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/firmware/include",
        "${workspaceFolder}/firmware/src",
        "${workspaceFolder}/firmware/src/proto",
        "${workspaceFolder}/firmware/src/native_stubs",
        "${workspaceFolder}/firmware/test",
        "${workspaceFolder}/firmware/.pio/libdeps/native/Unity/src",
        "${workspaceFolder}/firmware/.pio/libdeps/native/Nanopb",
        "${workspaceFolder}/firmware/.pio/libdeps/native/mbedtls/include"
      ],
      "defines": [
        "AIRTAK_NATIVE_TEST"
      ],
      "intelliSenseMode": "gcc-x64"
    }
  ],
  "version": 4
}
