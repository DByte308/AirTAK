{
  "build": {
    "arduino": {
      "ldscript": "nrf52840_s140_v6.ld"
    },
    "core": "nRF5",
    "cpu": "cortex-m4",
    "extra_flags": "-DARDUINO_NRF52840_TTGO_EINK -DNRF52840_XXAA",
    "f_cpu": "64000000L",
    "hwids": [
      ["0x239A", "0x4405"],
      ["0x239A", "0x0029"],
      ["0x239A", "0x002A"]
    ],
    "usb_product": "TTGO_eink",
    "mcu": "nrf52840",
    "variant": "t_echo",
    "variants_dir": "variants",
    "bsp": {
      "name": "adafruit"
    },
    "softdevice": {
      "sd_flags": "-DS140",
      "sd_name": "s140",
      "sd_version": "6.1.1",
      "sd_fwid": "0x00B6"
    },
    "bootloader": {
      "settings_addr": "0xFF000"
    }
  },
  "connectivity": ["bluetooth"],
  "debug": {
    "jlink_device": "nRF52840_xxAA",
    "onboard_tools": ["jlink"],
    "openocd_target": "nrf52840",
    "svd_path": "nRF52840_xxAA.svd"
  },
  "frameworks": ["arduino"],
  "name": "TTGO eink (LilyGo T-Echo)",
  "upload": {
    "maximum_ram_size": 248832,
    "maximum_size": 815104,
    "protocol": "nrfutil",
    "protocols": ["nrfutil", "nrfjprog", "jlink"]
  },
  "url": "https://lilygo.cc/products/t-echo-lilygo",
  "vendor": "LILYGO"
}
