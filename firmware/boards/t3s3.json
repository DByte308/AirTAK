{
  "_comment": "AirTAK — Airsoft Team Awareness Kit | firmware/boards/t3s3.json",
  "_pin_reference": "Pin mapping derived from meshtastic/firmware variants/esp32s3/tlora_t3s3_v1/variant.h, verified 2026-05-18.",
  "_radio_variants": "T3 S3 ships with one of: SX1262 (868/915MHz), SX1276 (868/915MHz), SX1280 (2.4GHz ±PA), LR1121 (dual-band). All share the same SPI bus (SCK=5, MISO=3, MOSI=6, CS=7) and board layout. AirTAK auto-detects the radio at boot (SX1262 → SX1276 → SX1280 → LR1121).",

  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "default_16MB.csv"
    },
    "core": "esp32",
    "extra_flags": "-DARDUINO_ESP32S3_DEV -DBOARD_HAS_PSRAM -mfix-esp32-psram-cache-issue -DARDUINO_USB_MODE=1 -DARDUINO_USB_CDC_ON_BOOT=1",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "flash_freq": "80m",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "psram": "opi"
  },
  "connectivity": ["wifi", "bluetooth"],
  "debug": {
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": ["arduino", "espidf"],
  "name": "LilyGo T-LoRa T3 S3",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 460800,
    "protocol": "esptool",
    "protocols": ["esptool", "espota"]
  },
  "url": "https://www.lilygo.cc/products/t3s3",
  "vendor": "LilyGo",

  "_pin_mapping": {
    "_note": "T3 S3 pin map per upstream Meshtastic T-LoRa T3-S3 v1 variant. ESP32-S3 with SSD1306 OLED (I2C), shared SPI radio bus, SD card on SPI1.",
    "OLED_SDA":        "GPIO 18  — I2C SDA for SSD1306 OLED",
    "OLED_SCL":        "GPIO 17  — I2C SCL for SSD1306 OLED",
    "LORA_SCK":        "GPIO 5   — shared SPI (all radio variants)",
    "LORA_MISO":       "GPIO 3   — shared SPI (all radio variants)",
    "LORA_MOSI":       "GPIO 6   — shared SPI (all radio variants)",
    "LORA_CS":         "GPIO 7   — shared SPI (all radio variants)",
    "LORA_RESET":      "GPIO 8   — shared reset (all radio variants)",
    "SX1262_DIO1":     "GPIO 33  — SX1262 interrupt",
    "SX1262_BUSY":     "GPIO 34  — SX1262 busy",
    "SX1276_DIO0":     "GPIO 9   — SX1276 interrupt",
    "SX1276_DIO1":     "GPIO 33  — SX1276 TCXO",
    "SX1276_DIO2":     "GPIO 34  — SX1276",
    "SX1276_RXEN":     "GPIO 21  — SX1276 RX enable",
    "SX1276_TXEN":     "GPIO 10  — SX1276 TX enable",
    "SX1280_DIO1":     "GPIO 9   — SX1280 interrupt",
    "SX1280_DIO2":     "GPIO 33  — SX1280",
    "SX1280_DIO3":     "GPIO 34  — SX1280",
    "SX1280_BUSY":     "GPIO 36  — SX1280 busy",
    "SX1280_RXEN":     "GPIO 21  — SX1280 RX enable",
    "SX1280_TXEN":     "GPIO 10  — SX1280 TX enable",
    "SDCARD_CS":        "GPIO 13  — SD card on SPI1",
    "BAT_ADC":          "GPIO 1   — battery voltage divider",
    "LED_POWER":        "GPIO 37  — power LED",
    "BUTTON":           "GPIO 0   — user button (active low, needs pullup)"
  }
}
