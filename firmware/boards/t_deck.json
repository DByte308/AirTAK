{
  "_comment": "AirTAK — Airsoft Team Awareness Kit | firmware/boards/t_deck.json",
  "_pin_reference": "Pin mapping derived from Xinyuan-LilyGO/T-Deck examples/UnitTest/utilities.h, verified 2026-05-16.",

  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "default_16MB.csv"
    },
    "core": "esp32",
    "extra_flags": "-DARDUINO_ESP32S3_DEV -DBOARD_HAS_PSRAM -mfix-esp32-psram-cache-issue -DARDUINO_USB_MODE=1 -DARDUINO_USB_CDC_ON_BOOT=1",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "flash_freq": "80m",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "psram": "opi"
  },
  "connectivity": ["wifi", "bluetooth"],
  "debug": {
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": ["arduino", "espidf"],
  "name": "LilyGo T-Deck",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 460800,
    "protocol": "esptool",
    "protocols": ["esptool", "espota"]
  },
  "url": "https://www.lilygo.cc/products/t-deck",
  "vendor": "LilyGo",

  "_pin_mapping": {
    "_note": "T-Deck pin map per Xinyuan-LilyGO/T-Deck utilities.h. PSRAM present; shared SPI bus between TFT and SX1262.",
    "POWER_EN":          "GPIO 10  — peripheral power rail enable (HIGH = on)",
    "SX1262_CS":         "GPIO 9",
    "SX1262_BUSY":       "GPIO 13",
    "SX1262_RST":        "GPIO 17",
    "SX1262_DIO1":       "GPIO 45",
    "SX1262_SCK":        "GPIO 40  — shared SPI",
    "SX1262_MOSI":       "GPIO 41  — shared SPI",
    "SX1262_MISO":       "GPIO 38  — shared SPI",
    "TFT_CS":            "GPIO 12",
    "TFT_DC":            "GPIO 11",
    "TFT_BL":            "GPIO 42",
    "TFT_SCK":           "GPIO 40  — shared SPI",
    "TFT_MOSI":          "GPIO 41  — shared SPI",
    "TFT_MISO":          "GPIO 38  — shared SPI",
    "SD_CS":             "GPIO 39",
    "I2C_SDA":           "GPIO 18  — keyboard, touch",
    "I2C_SCL":           "GPIO 8   — keyboard, touch",
    "KEYBOARD_INT":      "GPIO 46",
    "TOUCH_INT":         "GPIO 16",
    "TRACKBALL_UP":      "GPIO 3",
    "TRACKBALL_DOWN":    "GPIO 15",
    "TRACKBALL_LEFT":    "GPIO 1",
    "TRACKBALL_RIGHT":   "GPIO 2",
    "BAT_ADC":           "GPIO 4   — battery voltage divider",
    "GPS_TX_MCU":        "GPIO 43  — MCU UART TX → GPS RX (T-Deck-Plus GPS shield)",
    "GPS_RX_MCU":        "GPIO 44  — MCU UART RX ← GPS TX (T-Deck-Plus GPS shield)",
    "BOOT_BTN":          "GPIO 0   — user button (active low)"
  }
}
